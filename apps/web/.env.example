# SUPABASE PROJECT URL (Client)
# @description Public URL for the Supabase project, used in the frontend.
# @example "https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_URL=""

# SUPABASE ANON KEY (Client)
# @description Public anon key to access Supabase from the client.
# @warning This key is safe to expose but has limited access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ENVIRONMENT CONFIGURATION
# @description The current environment. Used for conditional logic in code.
# @example "development", "production", "test"
# default "development"
NODE_ENV="development"
