# ENVIRONMENT CONFIGURATION
# @description The current environment. Used for conditional logic in code.
# @example "development", "production", "test"
# default "development"
GO_ENV="development"

# SERVER PORT
# @description The port your backend server will run on.
# @default "8080"
PORT="8080"

# SUPABASE SERVICE ROLE KEY
# @description Secret key with elevated privileges, used server-side only.
# @warning NEVER expose this key on the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE PROJECT URL (Backend)
# @description Backend use of Supabase project URL (can be same as public one).
SUPABASE_URL=""

# SUPABASE JWT SECRET
# @description Secret used to verify and sign Supabase JWT tokens.
SUPABASE_JWT_SECRET=""

# SUPABASE JWT ISSUER
# @description The expected issuer of JWT tokens.
SUPABASE_ISSUER=""

# SUPABASE JWT AUDIENCE
# @description The expected audience claim in JWTs.
# @default "authenticated"
SUPABASE_AUDIENCE="authenticated"
